# --- Gistly environment ---

# Password for the admin (the only one who can create/edit/delete gists).
# If left empty, the app falls back to "admin" - CHANGE IT IN PRODUCTION!
ADMIN_PASSWORD=change-me-please

# Random secret used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
# If empty, a stable secret is derived from the admin password.
AUTH_SECRET=

# SQLite database file. In Docker the whole /app/db folder is a volume.
DATABASE_URL=file:/app/db/gistly.db
